# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api
# IMPORTANT: Copy this file to .env.local and fill in your actual values

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_actual_anon_key_here

# IMPORTANT: Never commit .env.local to version control!
# This file (.env.example) is safe to commit as it contains only placeholder values.
# 
# 🔒 SECURITY CHECKLIST:
# 1. Replace the placeholder values above with your actual Supabase credentials
# 2. Go to Supabase Dashboard → Settings → API → Regenerate keys (to rotate leaked keys)
# 3. Enable Row Level Security (RLS) on all tables in Supabase
# 4. Never commit .env.local to Git - it's already in .gitignore
